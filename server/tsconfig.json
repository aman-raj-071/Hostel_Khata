{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts", "prompts/**/*.ts", "../src/lib/types.ts", "../src/lib/contracts.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.integration.ts"]
}
