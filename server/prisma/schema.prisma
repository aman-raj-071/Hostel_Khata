generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdBy String? @map("created_by")
  requireApproval Boolean @default(true) @map("require_approval")
  expiresAt DateTime? @map("expires_at")
  owner User? @relation("GroupOwner", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  members   Member[]
  expenses  Expense[]
  invites GroupInvite[]
  paymentRecords Payment[]
  @@map("groups")
}

model Member {
  id       String @id @default(cuid())
  groupId  String @map("group_id")
  userId String? @map("user_id")
  role String @default("member")
  status String @default("active")
  joinedAt DateTime @default(now()) @map("joined_at")
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  name     String
  upiId    String? @map("upi_id")
  group    Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payments Expense[]
  shares   ExpenseShare[]
  @@unique([groupId, name])
  @@unique([groupId, userId])
  @@index([groupId])
  @@map("group_members")
}

model Expense {
  id          String @id @default(cuid())
  groupId     String @map("group_id")
  payerId     String @map("payer_id")
  amountPaise Int @map("amount_paise")
  description String
  category    String
  date        String
  rawText     String? @map("raw_text")
  createdAt   DateTime @default(now()) @map("created_at")
  group       Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payer       Member @relation(fields: [payerId], references: [id], onDelete: Restrict)
  shares      ExpenseShare[]
  settlement Payment?
  @@index([groupId, date])
  @@index([payerId])
  @@map("expenses")
}

model ExpenseShare {
  id         String @id @default(cuid())
  expenseId  String @map("expense_id")
  memberId   String @map("member_id")
  sharePaise Int @map("share_paise")
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member     Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  @@unique([expenseId, memberId])
  @@index([memberId])
  @@map("expense_shares")
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String? @map("password_hash")
  upiId String? @map("upi_id")
  color String
  createdAt DateTime @default(now()) @map("created_at")
  demoExpiresAt DateTime? @map("demo_expires_at")
  groups Group[] @relation("GroupOwner")
  memberships Member[]
  sessions Session[]
  invites GroupInvite[]
  sentPayments Payment[] @relation("PaymentSender")
  receivedPayments Payment[] @relation("PaymentReceiver")
  @@index([demoExpiresAt])
  @@map("users")
}
model Session {
  tokenHash String @id @map("token_hash")
  userId String @map("user_id")
  activeGroupId String? @map("active_group_id")
  expiresAt DateTime @map("expires_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}
model AuthAttempt {
  key String @id
  failures Int @default(0)
  windowStart DateTime @map("window_start")
  lockedUntil DateTime? @map("locked_until")
  @@map("auth_attempts")
}

model GroupInvite {
 id String @id @default(cuid())
 groupId String @map("group_id")
 code String @unique
 createdBy String @map("created_by")
 expiresAt DateTime @map("expires_at")
 maxUses Int? @map("max_uses")
 uses Int @default(0)
 revoked Boolean @default(false)
 createdAt DateTime @default(now()) @map("created_at")
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 creator User @relation(fields:[createdBy],references:[id],onDelete:Restrict)
 @@index([groupId])
 @@map("group_invites")
}

model Payment {
 id String @id @default(cuid())
 groupId String @map("group_id")
 fromUserId String @map("from_user_id")
 toUserId String @map("to_user_id")
 amountPaise Int @map("amount_paise")
 status String @default("pending")
 upiRef String? @map("upi_ref")
 note String @default("")
 createdAt DateTime @default(now()) @map("created_at")
 confirmedAt DateTime? @map("confirmed_at")
 settlementExpenseId String? @unique @map("settlement_expense_id")
 group Group @relation(fields:[groupId],references:[id],onDelete:Restrict)
 sender User @relation("PaymentSender",fields:[fromUserId],references:[id],onDelete:Restrict)
 receiver User @relation("PaymentReceiver",fields:[toUserId],references:[id],onDelete:Restrict)
 settlement Expense? @relation(fields:[settlementExpenseId],references:[id],onDelete:Restrict)
 @@index([groupId,status])
 @@map("payments")
}
