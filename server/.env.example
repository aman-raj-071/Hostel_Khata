# Local fallback. Use PostgreSQL in production and run db:generate after changing provider.
DATABASE_URL=file:./dev.db
# For Supabase/Neon migrations, set DIRECT_URL to a direct/unpooled PostgreSQL URL if needed.
# DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require
ANTHROPIC_API_KEY=
# Set to a model available in your Anthropic account.
ANTHROPIC_MODEL=
# Applies to parsing, reminder tones and Wrapped captions; no Anthropic calls when true.
USE_CLAUDE_STUB=true
PORT=3001
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080
GROUP_CODE=flat-302
# Render/Railway: set to your verified reverse-proxy hop count (usually 1).
TRUST_PROXY_HOPS=0
