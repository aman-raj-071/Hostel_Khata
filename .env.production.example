# Production Environment Variables for AWS Amplify
# Copy this to your Amplify Environment Variables section

# ====================================
# Backend API Environment Variables
# ====================================

# PostgreSQL Database Connection (Required)
# Get from AWS RDS or Neon.tech
DATABASE_URL=postgresql://username:password@host.region.rds.amazonaws.com:5432/hostel_khata?sslmode=require
DIRECT_URL=postgresql://username:password@host.region.rds.amazonaws.com:5432/hostel_khata?sslmode=require

# Server Configuration
PORT=3001
NODE_ENV=production
TRUST_PROXY_HOPS=1

# CORS - Set to your Amplify app URL
CORS_ORIGIN=https://main.d1234567890abc.amplifyapp.com

# AI Features (Optional)
USE_CLAUDE_STUB=false
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ====================================
# Frontend Environment Variables
# ====================================

# API Origin - Set to your backend API URL if deployed separately
# Leave empty if using /api proxy (same domain deployment)
VITE_API_URL=

# If backend is on separate domain:
# API_ORIGIN=https://your-api-domain.com

# ====================================
# AWS Amplify Specific (Auto-set)
# ====================================
# These are automatically set by Amplify:
# AWS_APP_ID
# AWS_BRANCH
# AWS_REGION
